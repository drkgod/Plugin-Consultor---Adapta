{
  "schemaVersion": "adapta-consultor-workflows/v2",
  "orchestrator": "skills/skill-mind/SKILL.md",
  "routing": "contracts/skill-mind.json",
  "layout": "contracts/workspace-layout.json",
  "persona": "personas/consultor-adapta.md",
  "jobs": {
    "gerar-escopo": {
      "skill": "skills/gerar-escopo/SKILL.md",
      "stages": ["resolver Plano — <id>", "reunir fontes reais", "gerar escopo base", "autoavaliar grounding", "registrar lacunas"],
      "inputs": ["01-documento/", "02-Reuniao/", "03-Projeto/00-DMO.md quando existir", "04-Mapeamento-Processos/"],
      "outputs": ["03-Projeto/01-Escopo.md"],
      "gates": ["fontes citadas", "lacunas e inferencias explicitas", "regeneracao nao sobrescreve silenciosamente"],
      "externalActions": []
    },
    "idear-direcoes": {
      "skill": "skills/idear-direcoes/SKILL.md",
      "stages": ["grounding", "decomposicao em eixos", "geracao divergente", "critica e rejeicao", "ranking e verificacao da base"],
      "inputs": ["03-Projeto/01-Escopo.md", "02-Reuniao/", "04-Mapeamento-Processos/", "precedentes quando disponiveis"],
      "outputs": ["03-Projeto/direcoes.md"],
      "gates": ["cada direcao sobrevivente tem evidencia, hipotese, custo e risco"],
      "externalActions": []
    },
    "definir-requisitos": {
      "skill": "skills/definir-requisitos/SKILL.md",
      "stages": ["classificacao de complexidade", "separacao de fatos e inferencias", "definicao de comportamento e limites", "analise de fluxo e pontos cegos", "sintese de requisitos"],
      "inputs": ["03-Projeto/01-Escopo.md", "03-Projeto/direcoes.md quando existir", "02-Reuniao/", "04-Mapeamento-Processos/"],
      "outputs": ["03-Projeto/requisitos.md"],
      "gates": ["ator, resultado, limites, sucesso, premissas e decisoes pendentes estao explicitos"],
      "externalActions": []
    },
    "revisar-escopo": {
      "skill": "skills/revisar-escopo/SKILL.md",
      "stages": ["montagem do pacote de contexto", "painel critico dinamico", "deduplicacao", "separacao de falhas, decisoes e alternativas", "registro da revisao"],
      "inputs": ["03-Projeto/01-Escopo.md", "direcoes.md e requisitos.md quando aplicaveis", "02-Reuniao/", "04-Mapeamento-Processos/"],
      "outputs": ["03-Projeto/revisao-do-escopo.md"],
      "gates": ["nucleo do painel concluido ou cobertura parcial registrada", "achados citam evidencia e cenario de falha"],
      "externalActions": []
    },
    "analise-critica": {
      "skill": "skills/analise-critica/SKILL.md",
      "stages": ["classificar rota leve, padrao ou profunda", "orquestrar skills especializadas", "conselho-de-decisao condicional", "sintese", "template humano"],
      "inputs": ["03-Projeto/01-Escopo.md", "direcoes.md quando aplicavel", "requisitos.md quando aplicavel", "revisao-do-escopo.md", "02-Reuniao/", "04-Mapeamento-Processos/"],
      "outputs": ["03-Projeto/analise-critica.md", "03-Projeto/analise-do-consultor.md"],
      "gates": ["rota executada registrada", "analise humana permanece pendente"],
      "externalActions": []
    },
    "escopo-definitivo": {
      "skill": "skills/escopo-definitivo/SKILL.md",
      "stages": ["consolidacao das fontes", "composicao das fases 1-3 de sistemas, fase 4 de loops/agentes e fase 5 de validacao", "ce-doc-review adaptado", "correcoes seguras", "rastreabilidade final"],
      "inputs": ["03-Projeto/01-Escopo.md", "03-Projeto/analise-critica.md", "03-Projeto/analise-do-consultor.md preenchida"],
      "outputs": ["03-Projeto/02-Escopo-Definitivo.md", "03-Projeto/02-Plano_de_acao/", "03-Projeto/02-Plano_de_acao/matriz-de-rastreabilidade.md"],
      "gates": ["decisoes humanas respondidas", "fases 1-3 constroem sistemas, fase 4 opera loops/agentes e fase 5 valida as fases 1-4", ".adapta/checks/check-escopo.md permanece pendente"],
      "externalActions": []
    },
    "gerar-setup-ethos": {
      "skill": "skills/gerar-setup-ethos/SKILL.md",
      "stages": ["extrair contexto aprovado", "gerar SOUL IDENTITY e USER", "sugerir conectores e automacoes", "mapear agentes e loops", "registrar pendencias da call de setup"],
      "inputs": ["03-Projeto/02-Escopo-Definitivo.md", "03-Projeto/analise-critica.md", "03-Projeto/analise-do-consultor.md preenchida", "02-Reuniao/", "04-Mapeamento-Processos/"],
      "outputs": ["03-Projeto/03-Setup-Ethos/00-INDICE.md", "03-Projeto/03-Setup-Ethos/SOUL.md", "03-Projeto/03-Setup-Ethos/IDENTITY.md", "03-Projeto/03-Setup-Ethos/USER.md", "03-Projeto/03-Setup-Ethos/sugestoes-conectores-automacoes.md", "03-Projeto/03-Setup-Ethos/mapa-de-agentes-e-loops.md", "03-Projeto/03-Setup-Ethos/loops/LOOP-NN-<slug>.md"],
      "gates": ["conteudo rastreado a fontes", "lacunas marcadas para a call", "nenhum conector loop ou autonomia e ativado por inferencia"],
      "externalActions": []
    },
    "gerar-specs": {
      "skill": "skills/gerar-specs/SKILL.md",
      "stages": ["ler escopo definitivo e rastreabilidade", "selecionar contrato da fase", "compor SPECs profundas da fase em foco em modo onda", "acoplar TDD executavel", "revisar contrato, aceite e TDD", "atualizar indice e matriz"],
      "inputs": ["03-Projeto/02-Escopo-Definitivo.md", "fase em foco", "evolucoes aceitas e ledger de dividas quando houver", "check-escopo aprovado", "check-cliente aprovado"],
      "outputs": ["03-Projeto/02-Plano_de_acao/0N.Fase_N/01-SPECs/spec-*.md", "03-Projeto/02-Plano_de_acao/0N.Fase_N/01-SPECs/00-INDICE.md", "03-Projeto/02-Plano_de_acao/matriz-de-rastreabilidade.md ate a camada SPEC"],
      "gates": ["Consultor e CSM/cliente aprovaram o escopo", "fases 1-3 nao deixam decisao estrutural para o Ethos", "fase 4 preenche Meta Validacao Conectores Skills e Arranque", "fase 5 cobre todas as entregas das fases 1-4", "cada SPEC possui checklist, aceite e TDD"],
      "externalActions": []
    },
    "gerar-tasks": {
      "skill": "skills/gerar-tasks/SKILL.md",
      "stages": ["ler SPECs revisadas", "decompor por papel, sessao e recorte de prova", "validar independencia", "sincronizar projecoes", "revisar rastreabilidade"],
      "inputs": ["SPECs revisadas da fase em foco", "03-Projeto/02-Plano_de_acao/0N.Fase_N/", "03-Projeto/02-Plano_de_acao/matriz-de-rastreabilidade.md", "gates aprovados"],
      "outputs": ["00.tasks_per_fase/fase_N.md atualizado", "0N.Fase_N/00-Tasks_Gerais.md atualizado", "Tasks vinculadas nas SPECs", "matriz-de-rastreabilidade.md completa ate task e prova"],
      "gates": ["toda task aponta para SPEC e subsecao exata", "tasks da mesma leva sao independentes", "criterio binario recorte da prova e ponto de parada estao explicitos"],
      "externalActions": []
    },
    "gerar-pasta-cliente": {
      "skill": "skills/gerar-pasta-cliente/SKILL.md",
      "inputs": ["template cliente", "escopo definitivo", "tasks da fase", "SPECs validas com TDD", "ajustes da reuniao incorporados"],
      "outputs": ["pasta cliente", "handoff-manifest.json"],
      "gates": ["check-escopo e check-cliente aprovados", "recibo vincula reuniao de corte aos hashes atuais", "dry-run aprovado", "confirmacao antes de criar repo ou publicar"],
      "externalActions": ["criar repo", "push"]
    },
    "liberar-fase": {
      "skill": "skills/liberar-fase/SKILL.md",
      "inputs": ["fase atual fechada", "evidencias", "evolucoes decididas"],
      "outputs": [".adapta/checks/check-fase-N.md", ".adapta/evolucoes/delta-fase-N+1.md", "phase-closure-manifest.json", "SPECs e tasks da proxima fase", "handoff da proxima fase"],
      "gates": ["todas as tasks concluidas", "criterios demonstrados", "fase 5 valida todas as entregas das fases 1-4", "check humano vinculado ao active-sha256 atual", "consultor aprova delta"],
      "externalActions": ["push no repo do cliente"]
    },
    "concluir-task": {
      "skill": "skills/concluir-task/SKILL.md",
      "inputs": ["task", "SPEC", "artefato", "evidencias"],
      "outputs": [".adapta/checks/tasks/<id>.json", "STATUS.md", "changelog.md"],
      "gates": ["todos os criterios e provas passam"],
      "externalActions": []
    },
    "mapear-evolucoes": {
      "skill": "skills/mapear-evolucoes/SKILL.md",
      "inputs": ["reunioes", "tasks", "debugs", "decisoes", "resultado da fase"],
      "outputs": [".adapta/evolucoes/evolucoes-fase-N.md"],
      "gates": ["humano classifica aceitar, rejeitar ou adiar"],
      "externalActions": []
    },
    "aprendizado-continuo": {
      "skill": "skills/aprendizado-continuo/SKILL.md",
      "stages": ["consultar precedentes", "capturar candidato atomico", "reforcar ou contradizer", "grounding e privacidade", "promover com gate", "evoluir clusters"],
      "inputs": ["sinal estruturado", "evidencia", "causa raiz"],
      "outputs": [".adapta/aprendizados/candidatos/<id>.json", "aprendizado anonimizado quando aprovado"],
      "gates": ["privacidade validada", "aprovacao antes de promover"],
      "externalActions": ["escrever ou publicar no acervo compartilhado"]
    },
    "tldv": {
      "skill": "skills/tldv/SKILL.md",
      "inputs": ["link oficial ou email com intervalo", "TLDV_API_KEY no ambiente ou export local", "categoria da reuniao"],
      "outputs": ["02-Reuniao/<Categoria>/NN. DD.MM.AAAA - Assunto/", "02-Reuniao/_tldv_manifest.json", "02-Reuniao/00-Indice_reunioes.md"],
      "gates": ["selecao humana das reunioes", "transcript valido"],
      "externalActions": ["leitura da API tl;dv"]
    },
    "debugar": {
      "skill": "skills/debugar/SKILL.md",
      "stages": ["reproducao", "cadeia causal", "hipoteses e predicoes", "gate de causa raiz", "correcao autorizada contra a SPEC e seu TDD", "verificacao"],
      "inputs": ["sintoma reproduzivel", "artefato ou workflow afetado"],
      "outputs": [".adapta/debug/debug-<data>-<slug>.md", "candidato de aprendizado quando reutilizavel"],
      "gates": ["decisao humana para mudanca de escopo, fonte ou metodo"],
      "externalActions": []
    }
  }
}
