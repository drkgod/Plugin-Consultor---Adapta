{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "adapta-task-result/v1",
  "type": "object",
  "required": ["taskId", "status", "criteria", "evidence", "residualRisks"],
  "properties": {
    "taskId": {"type": "string", "minLength": 1},
    "status": {"enum": ["aprovada", "reprovada", "bloqueada"]},
    "criteria": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["criterion", "passed", "proof"], "properties": {"criterion": {"type": "string", "minLength": 1}, "passed": {"type": "boolean"}, "proof": {"type": "string", "minLength": 1}}}},
    "evidence": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "residualRisks": {"type": "array", "items": {"type": "string"}},
    "blocker": {"type": "object", "required": ["reason", "owner", "nextAction"], "properties": {"reason": {"type": "string", "minLength": 1}, "owner": {"type": "string", "minLength": 1}, "nextAction": {"type": "string", "minLength": 1}}, "additionalProperties": false}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "aprovada"}}, "required": ["status"]},
      "then": {
        "properties": {
          "criteria": {"items": {"properties": {"passed": {"const": true}}, "required": ["passed"]}},
          "evidence": {"minItems": 1}
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "reprovada"}}, "required": ["status"]},
      "then": {"properties": {"criteria": {"contains": {"properties": {"passed": {"const": false}}, "required": ["passed"]}}}}
    },
    {
      "if": {"properties": {"status": {"const": "bloqueada"}}, "required": ["status"]},
      "then": {"required": ["blocker"]}
    }
  ],
  "additionalProperties": false
}
