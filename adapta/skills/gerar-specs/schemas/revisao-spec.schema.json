{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "adapta-spec-review/v1",
  "type": "object",
  "required": ["reviewer", "status", "findings", "evidence"],
  "properties": {
    "reviewer": {"type": "string", "minLength": 1},
    "status": {"enum": ["completo", "parcial", "falhou"]},
    "findings": {"type": "array", "items": {"type": "object", "required": ["severity", "requirement", "problem", "proof"], "properties": {"severity": {"enum": ["grave", "moderado", "baixo"]}, "requirement": {"type": "string", "minLength": 1}, "problem": {"type": "string", "minLength": 1}, "proof": {"type": "string", "minLength": 1}}}},
    "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "failureReason": {"type": "string"}
  },
  "additionalProperties": false
}
