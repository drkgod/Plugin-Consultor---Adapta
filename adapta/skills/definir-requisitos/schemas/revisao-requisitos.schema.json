{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "adapta-requirements-review/v1",
  "type": "object",
  "required": ["reviewer", "status", "findings", "evidence"],
  "properties": {
    "reviewer": {"type": "string", "minLength": 1},
    "status": {"enum": ["completo", "parcial", "falhou"]},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["severity", "requirement", "gap", "proof", "decisionOwner"],
        "properties": {
          "severity": {"enum": ["grave", "moderado", "baixo"]},
          "requirement": {"type": "string", "minLength": 1},
          "gap": {"type": "string", "minLength": 1},
          "proof": {"type": "string", "minLength": 1},
          "decisionOwner": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "evidence": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "failureReason": {"type": "string"}
  },
  "additionalProperties": false
}
